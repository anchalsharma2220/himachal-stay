# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (local) - or paste your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/himachal_pg

# JWT (change the secret!)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Insert demo data automatically when the database is empty
AUTO_SEED=true
